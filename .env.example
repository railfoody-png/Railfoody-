# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ---------------- PRODUCTION SMS GATEWAY CONFIGURATION ----------------
# Choose your preferred SMS provider. If none are set, RailFoody runs in secure sandbox mode
# with server console OTP delivery logs for development and testing.

# Option 1: Fast2SMS (Recommended for Indian Mobile Numbers / DLT / OTP Route)
# Get your API key from https://www.fast2sms.com/
FAST2SMS_API_KEY=""

# Option 2: MSG91 (DLT Compliant OTP Gateway)
# Get your keys from https://msg91.com/
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# Option 3: Twilio (Global SMS)
# Get your credentials from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Option 4: Custom SMS HTTP Webhook / Gateway
# Endpoint that receives POST { phone, otp, message }
CUSTOM_SMS_URL=""
CUSTOM_SMS_API_KEY=""

# Admin & Customer Auth Secrets
ADMIN_JWT_SECRET="railfoody-production-secret-token-key-2026"
